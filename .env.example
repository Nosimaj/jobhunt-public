# Copy to `.env` in the repo root, fill in the real key, then `chmod 600 .env`.
# `.env` is gitignored and must stay that way - this file is the tracked
# placeholder and must never contain a real credential.
#
# To keep the secret outside the repo instead, put this file anywhere and
# export JOBHUNT_ENV_FILE=/path/to/that/file. A path that does not exist is a
# hard error, not a silent fallback to the repo `.env`.
#
# Read by `python -m jobhunt.ingest` (one call to structure your resume),
# `jobhunt.matching` and `jobhunt.generate`. Discovery makes no API calls.
ANTHROPIC_API_KEY=sk-ant-replace-me
